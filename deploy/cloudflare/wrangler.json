{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuphos-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "containers": [
    {
      "class_name": "NuphosBackend",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": { "bindings": [{ "name": "BACKEND", "class_name": "NuphosBackend" }] },
  "exports": { "NuphosBackend": { "type": "durable-object", "storage": "sqlite" } }
}

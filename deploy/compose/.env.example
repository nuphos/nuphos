# Create .env with ./init-env.sh (fills every secret below), or copy this file
# and run the command noted on each line. .env is gitignored; never commit it.

# Backend session signing secret. The backend also derives the key that encrypts
# runtime passwords and Claude tokens from it, so keep it stable.  openssl rand -hex 32
NUPHOS_JWT_SECRET=
# RustFS root credentials, reused by the backend's three S3 stores.  openssl rand -hex 32
S3_ACCESS_KEY=nuphos-local
S3_SECRET_KEY=

# nuphos-runtime image tag (Claude Code variant).
RUNTIME_TAG=0.1.18-claude-code
# Host port for the backend API (bound to 127.0.0.1).
BACKEND_PORT=3000
# Host port for RustFS. Desktop file transfers use presigned http://rustfs:9000 URLs, so keep 9000 unless you only need the API.
RUSTFS_PORT=9000
# Mongo is published only by `bun run dev`; runtime is published by both stacks.
MONGO_PORT=27117
RUNTIME_PORT=18180

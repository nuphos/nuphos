{
  "name": "nuphos",
  "private": true,
  "version": "0.0.0",
  "description": "Nuphos monorepo — `bun run dev` boots backend + desktop with a live dashboard.",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "e2e": "bun scripts/e2e/run.ts",
    "e2e:reminder-tasks": "bun scripts/e2e/run-reminder-tasks.ts",
    "e2e:reminders": "bun scripts/e2e/run-reminders.ts",
    "e2e:bot-onboarding": "node --experimental-strip-types scripts/e2e/run-bot-onboarding.ts",
    "e2e:chat-switch": "bun scripts/e2e/run-chat-switch.ts",
    "e2e:entry-points": "bun scripts/e2e/run-entry-points.ts",
    "e2e:session-homes": "bun scripts/e2e/run-session-homes.ts",
    "dev:stop": "bun scripts/dev-stack-cli.ts stop",
    "dev:reset": "bun scripts/dev-stack-cli.ts reset",
    "dev:logs": "bun scripts/dev-stack-cli.ts logs",
    "dev:ps": "bun scripts/dev-stack-cli.ts ps",
    "dev:login": "bun scripts/dev-stack-cli.ts login",
    "dev:runtime-password": "bun scripts/dev-stack-cli.ts runtime-password",
    "dev:instances": "bun scripts/dev-stack-cli.ts instances",
    "test": "node --test --experimental-strip-types scripts/*.test.mjs scripts/*.test.ts eslint-rules/*.test.mjs packages/*/src/*.test.mjs",
    "lint": "eslint scripts eslint-rules",
    "check:cycles": "node scripts/check-import-cycles.mjs",
    "format": "prettier --experimental-cli --write .",
    "format:check": "prettier --experimental-cli --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-unicorn": "72.0.0",
    "globals": "^17.8.0",
    "madge": "8.0.0",
    "playwright-core": "1.65.0",
    "prettier": "3.9.6",
    "typescript-eslint": "^8.65.0"
  },
  "trustedDependencies": []
}

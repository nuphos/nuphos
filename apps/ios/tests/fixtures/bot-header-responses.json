  "GET /agent/conversations/chat-bot-trip": {
    "status": 200,
    "body": {
      "sessionId": "chat-bot-trip",
      "kind": "channel",
      "title": "Trip planner",
      "messages": [
        {
          "id": "m0",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Plan a two-day trip to Lisbon for the first weekend of March."
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "user",
              "id": "507f1f77bcf86cd799439011",
              "displayName": "Preview User",
              "avatarURL": ""
            },
            "sentAt": "2026-11-08T09:20:00.000Z"
          },
          "createdAt": "2026-11-08T09:20:00.000Z"
        },
        {
          "id": "m1",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Happy to. Do you want a slow pace with long lunches, or as many sights as fit?"
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "agent",
              "id": "bot-trip",
              "displayName": "Trip planner"
            },
            "sentAt": "2026-11-08T09:21:00.000Z"
          },
          "createdAt": "2026-11-08T09:21:00.000Z"
        },
        {
          "id": "m2",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Slow pace. We like food markets and walking."
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "user",
              "id": "507f1f77bcf86cd799439011",
              "displayName": "Preview User",
              "avatarURL": ""
            },
            "sentAt": "2026-11-08T09:22:00.000Z"
          },
          "createdAt": "2026-11-08T09:22:00.000Z"
        },
        {
          "id": "m3",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Day one: start at Time Out Market for breakfast, then walk along the river to Belém."
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "agent",
              "id": "bot-trip",
              "displayName": "Trip planner"
            },
            "sentAt": "2026-11-08T09:23:00.000Z"
          },
          "createdAt": "2026-11-08T09:23:00.000Z"
        },
        {
          "id": "m4",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Pastéis de Belém opens at 8. The queue is shortest before 9."
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "agent",
              "id": "bot-trip",
              "displayName": "Trip planner"
            },
            "sentAt": "2026-11-08T09:24:00.000Z"
          },
          "createdAt": "2026-11-08T09:24:00.000Z"
        },
        {
          "id": "m5",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "In the afternoon, take tram 28 up to Alfama and watch the sunset from Miradouro da Senhora do Monte."
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "agent",
              "id": "bot-trip",
              "displayName": "Trip planner"
            },
            "sentAt": "2026-11-08T09:25:00.000Z"
          },
          "createdAt": "2026-11-08T09:25:00.000Z"
        },
        {
          "id": "m6",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Nice. What about day two?"
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "user",
              "id": "507f1f77bcf86cd799439011",
              "displayName": "Preview User",
              "avatarURL": ""
            },
            "sentAt": "2026-11-08T09:26:00.000Z"
          },
          "createdAt": "2026-11-08T09:26:00.000Z"
        },
        {
          "id": "m7",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Day two: a morning in LX Factory, lunch at a tasca in Bairro Alto, and an evening fado show."
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "agent",
              "id": "bot-trip",
              "displayName": "Trip planner"
            },
            "sentAt": "2026-11-08T09:27:00.000Z"
          },
          "createdAt": "2026-11-08T09:27:00.000Z"
        },
        {
          "id": "m8",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "I would book the fado show now. The small venues fill up a week ahead."
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "agent",
              "id": "bot-trip",
              "displayName": "Trip planner"
            },
            "sentAt": "2026-11-08T09:28:00.000Z"
          },
          "createdAt": "2026-11-08T09:28:00.000Z"
        },
        {
          "id": "m9",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Book it for two at 9 pm if you can."
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "user",
              "id": "507f1f77bcf86cd799439011",
              "displayName": "Preview User",
              "avatarURL": ""
            },
            "sentAt": "2026-11-08T09:29:00.000Z"
          },
          "createdAt": "2026-11-08T09:29:00.000Z"
        },
        {
          "id": "m10",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Done: two seats at 9 pm on Saturday. The confirmation is in your inbox."
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "agent",
              "id": "bot-trip",
              "displayName": "Trip planner"
            },
            "sentAt": "2026-11-08T09:30:00.000Z"
          },
          "createdAt": "2026-11-08T09:30:00.000Z"
        },
        {
          "id": "m11",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Can you put both days on one page I can share?"
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "user",
              "id": "507f1f77bcf86cd799439011",
              "displayName": "Preview User",
              "avatarURL": ""
            },
            "sentAt": "2026-11-08T09:31:00.000Z"
          },
          "createdAt": "2026-11-08T09:31:00.000Z"
        },
        {
          "id": "m12",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Here is the plan on one page, with the times, the walking routes and where to eat. Open it from the link and share it with whoever is coming."
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "agent",
              "id": "bot-trip",
              "displayName": "Trip planner"
            },
            "sentAt": "2026-11-08T09:32:00.000Z"
          },
          "createdAt": "2026-11-08T09:32:00.000Z"
        },
        {
          "id": "m13",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Perfect, thank you!"
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "user",
              "id": "507f1f77bcf86cd799439011",
              "displayName": "Preview User",
              "avatarURL": ""
            },
            "sentAt": "2026-11-08T09:33:00.000Z"
          },
          "createdAt": "2026-11-08T09:33:00.000Z"
        },
        {
          "id": "m14",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Have a good trip. Tell me if the weather turns and I will move the river walk to Sunday."
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "agent",
              "id": "bot-trip",
              "displayName": "Trip planner"
            },
            "sentAt": "2026-11-08T09:34:00.000Z"
          },
          "createdAt": "2026-11-08T09:34:00.000Z"
        }
      ],
      "messagesFirstIndex": 0,
      "messageCount": 15,
      "transcriptUpdatedAt": "2026-11-08T09:34:00.000Z",

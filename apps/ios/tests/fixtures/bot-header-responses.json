  "GET /agent/conversations/chat-hike": {
    "status": 200,
    "body": {
      "sessionId": "chat-hike",
      "kind": "channel",
      "title": "weekend-hike",
      "messages": [
        {
          "id": "m0",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Who is in for the hike on Saturday?"
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "user",
              "id": "6650aa11bb22cc33dd44ee55",
              "displayName": "Mei Chen",
              "avatarURL": ""
            },
            "sentAt": "2026-11-08T09:20:00.000Z"
          },
          "createdAt": "2026-11-08T09:20:00.000Z"
        },
        {
          "id": "m1",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Me! Which trail?"
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "user",
              "id": "507f1f77bcf86cd799439011",
              "displayName": "Preview User",
              "avatarURL": ""
            },
            "sentAt": "2026-11-08T09:21:00.000Z"
          },
          "createdAt": "2026-11-08T09:21:00.000Z"
        },
        {
          "id": "m2",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "@Trip planner can you suggest something under 12 km?"
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "user",
              "id": "6650aa11bb22cc33dd44ee55",
              "displayName": "Mei Chen",
              "avatarURL": ""
            },
            "sentAt": "2026-11-08T09:22:00.000Z"
          },
          "createdAt": "2026-11-08T09:22:00.000Z"
        },
        {
          "id": "m3",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Sintra's Monserrate loop is 9 km with shade most of the way. The first train from Rossio is at 6:11."
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "agent",
              "id": "bot-trip",
              "displayName": "Trip planner"
            },
            "sentAt": "2026-11-08T09:23:00.000Z"
          },
          "createdAt": "2026-11-08T09:23:00.000Z"
        },
        {
          "id": "m4",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Rain is unlikely before 3 pm, so starting early works."
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "agent",
              "id": "bot-trip",
              "displayName": "Trip planner"
            },
            "sentAt": "2026-11-08T09:24:00.000Z"
          },
          "createdAt": "2026-11-08T09:24:00.000Z"
        },
        {
          "id": "m5",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "Great, let's take the 7:41."
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "user",
              "id": "6650aa11bb22cc33dd44ee55",
              "displayName": "Mei Chen",
              "avatarURL": ""
            },
            "sentAt": "2026-11-08T09:25:00.000Z"
          },
          "createdAt": "2026-11-08T09:25:00.000Z"
        },
        {
          "id": "m6",
          "role": "user",
          "parts": [
            {
              "type": "text",
              "text": "I'll bring snacks."
            }
          ],
          "metadata": {
            "version": 1,
            "sender": {
              "type": "user",
              "id": "507f1f77bcf86cd799439011",
              "displayName": "Preview User",
              "avatarURL": ""
            },
            "sentAt": "2026-11-08T09:26:00.000Z"
          },
          "createdAt": "2026-11-08T09:26:00.000Z"
        }
      ],

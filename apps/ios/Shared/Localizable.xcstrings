    "Drag to move the pointer. Tap to click, two fingers to scroll." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para mover el puntero. Toca para hacer clic y usa dos dedos para desplazarte."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret untuk memindahkan penunjuk. Ketuk untuk mengeklik, dua jari untuk menggulir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグでポインタを移動。タップでクリック、2 本指でスクロールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그해 포인터를 이동하세요. 탭하면 클릭, 두 손가락으로 스크롤합니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลากเพื่อย้ายตัวชี้ แตะเพื่อคลิก ใช้สองนิ้วเพื่อเลื่อน"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动以移动指针。轻点即点击，双指可滚动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖曳以移動游標。點一下即點擊，雙指可捲動。"
          }
        }
      }
    },
    "Edit" : {
      "localizations" : {

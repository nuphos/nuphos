    "3. Connect your computer and add a runtime." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Conecta tu ordenador y añade un entorno de ejecución."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Hubungkan komputer dan tambahkan runtime."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. コンピュータを接続してランタイムを追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. 컴퓨터를 연결하고 런타임을 추가하세요."
          }

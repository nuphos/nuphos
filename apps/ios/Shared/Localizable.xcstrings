    "AI data sharing is off. Close Account to read the notice." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El uso compartido de datos con IA está desactivado. Cierra Cuenta para leer el aviso."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berbagi data AI nonaktif. Tutup Akun untuk membaca pemberitahuan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI データ共有はオフです。お知らせを読むにはアカウントを閉じてください。"
          }

    "This account's session expired. Sign in again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión de esta cuenta caducó. Vuelve a iniciar sesión."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi akun ini telah kedaluwarsa. Masuk lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントのセッションの有効期限が切れました。もう一度サインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 계정의 세션이 만료되었습니다. 다시 로그인하세요."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซสชันของบัญชีนี้หมดอายุแล้ว โปรดลงชื่อเข้าใช้อีกครั้ง"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

    "Account not connected yet? Add it in Connectors, then return here and choose it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Aún no conectaste la cuenta? Añádela en Conectores y vuelve aquí para elegirla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akun belum terhubung? Tambahkan di Konektor, lalu kembali ke sini dan pilih."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントがまだ接続されていませんか？コネクタで追加してから、ここに戻って選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정이 아직 연결되지 않았나요? 커넥터에서 추가한 다음 여기로 돌아와 선택하세요."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่ได้เชื่อมต่อบัญชีใช่ไหม เพิ่มในตัวเชื่อมต่อ แล้วกลับมาเลือกที่นี่"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "账号还没连接？请在“连接器”中添加，再回到这里选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帳號還沒連接？請在「連接器」中新增，再回到這裡選擇。"
          }
        }
      }
    },
    "Account not connected yet? Ask a team administrator to add it in Connectors, then return here and choose it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Aún no conectaste la cuenta? Pide a un administrador del equipo que la añada en Conectores y vuelve aquí para elegirla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akun belum terhubung? Minta administrator tim untuk menambahkannya di Konektor, lalu kembali ke sini dan pilih."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントがまだ接続されていませんか？チームの管理者にコネクタで追加してもらい、ここに戻って選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정이 아직 연결되지 않았나요? 팀 관리자에게 커넥터에서 추가해 달라고 요청한 다음 여기로 돌아와 선택하세요."
          }
        },
        "th" : {
          "stringUnit" : {

    "The agent is still building this plan — steps, cost and risk arrive before it can be approved." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El agente aún está preparando este plan: los pasos, el costo y el riesgo llegarán antes de que se pueda aprobar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agen masih menyusun rencana ini — langkah, biaya, dan risiko akan muncul sebelum dapat disetujui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

    "Shared Keychain access failed (%d). Both App IDs and profiles need the same shared Keychain group." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo acceder al llavero compartido (%d). Ambos App ID y perfiles necesitan el mismo grupo de llavero compartido."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses Keychain bersama gagal (%d). Kedua App ID dan profil memerlukan grup Keychain bersama yang sama."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有キーチェーンにアクセスできませんでした（%d）。両方の App ID とプロファイルに同じ共有キーチェーングループが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 키체인에 접근하지 못했습니다(%d). 두 App ID와 프로파일 모두 같은 공유 키체인 그룹이 필요합니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เข้าถึงพวงกุญแจที่แชร์ไม่สำเร็จ (%d) App ID และโปรไฟล์ทั้งสองต้องใช้กลุ่มพวงกุญแจที่แชร์เดียวกัน"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法访问共享钥匙串（%d）。两个 App ID 和描述文件都需要相同的共享钥匙串组。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法存取共用鑰匙圈（%d）。兩個 App ID 與描述檔都需要相同的共用鑰匙圈群組。"
          }
        }
      }
    },
    "Shared sign-in is unavailable. Open Nuphos and sign in; both targets require matching shared Keychain provisioning." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión compartido no está disponible. Abre Nuphos e inicia sesión; ambos destinos necesitan la misma configuración de llavero compartido."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masuk bersama tidak tersedia. Buka Nuphos dan masuk; kedua target memerlukan penyediaan Keychain bersama yang cocok."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有サインインを利用できません。Nuphos を開いてサインインしてください。両方のターゲットに一致する共有キーチェーンのプロビジョニングが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 로그인을 사용할 수 없습니다. Nuphos를 열고 로그인하세요. 두 타깃 모두 일치하는 공유 키체인 프로비저닝이 필요합니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้การลงชื่อเข้าใช้ที่แชร์ไม่ได้ เปิด Nuphos แล้วลงชื่อเข้าใช้ ทั้งสองเป้าหมายต้องตั้งค่าพวงกุญแจที่แชร์ให้ตรงกัน"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法使用共享登录。请打开 Nuphos 并登录；两个 target 都需要匹配的共享钥匙串配置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法使用共用登入。請開啟 Nuphos 並登入；兩個 target 都需要相符的共用鑰匙圈設定。"
          }
        }
      }
    },

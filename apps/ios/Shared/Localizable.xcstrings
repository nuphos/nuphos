    "Get notified when a computer you own or use has been offline for 2 minutes, and when it's back." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe un aviso cuando una computadora tuya o que usas lleve 2 minutos sin conexión, y cuando vuelva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapatkan notifikasi saat komputer yang Anda miliki atau gunakan offline selama 2 menit, dan saat kembali online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

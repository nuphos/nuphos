        }
      }
    },
    "This agent is busy with another reply." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este agente está ocupado con otra respuesta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agen ini sedang sibuk dengan balasan lain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエージェントは別の返信を処理中です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 에이전트는 다른 답변을 처리하고 있습니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เอเจนต์นี้กำลังตอบอีกคำตอบหนึ่งอยู่"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个 Agent 正在处理另一个回复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個 Agent 正在處理另一個回覆。"
          }
        }
      }
    },
    "This computer asks for an account to show its screen. Update Nuphos on it to open its desktop without one." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta computadora pide una cuenta para mostrar su pantalla. Actualiza Nuphos en ella para abrir su escritorio sin cuenta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komputer ini meminta akun untuk menampilkan layarnya. Perbarui Nuphos di sana agar desktop dapat dibuka tanpa akun."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコンピュータは画面を表示するためにアカウントを求めています。そのコンピュータの Nuphos をアップデートすると、アカウントなしでデスクトップを開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 컴퓨터는 화면을 표시하려면 계정이 필요합니다. 해당 컴퓨터의 Nuphos를 업데이트하면 계정 없이 데스크톱을 열 수 있습니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คอมพิวเตอร์เครื่องนี้ต้องใช้บัญชีเพื่อแสดงหน้าจอ อัปเดต Nuphos บนเครื่องนั้นเพื่อเปิดเดสก์ท็อปโดยไม่ต้องใช้บัญชี"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台电脑需要账号才能显示画面。请在那台电脑上更新 Nuphos，即可免账号打开桌面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這台電腦需要帳號才能顯示畫面。請在那台電腦上更新 Nuphos，即可免帳號開啟桌面。"
          }
        }
      }
    },
    "This conversation has no computer to open a terminal on." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conversación no tiene ninguna computadora donde abrir una terminal."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percakapan ini tidak memiliki komputer untuk membuka terminal."

    "%@ belongs to a teammate, so only they can sign it in. Ask them to open Nuphos on it and choose Sign in on the Runtimes page." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pertenece a un compañero, así que solo esa persona puede iniciar sesión. Pídele que abra Nuphos en ese equipo y elija Iniciar sesión en la página Entornos de ejecución."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ milik rekan tim, jadi hanya mereka yang dapat memasukkannya. Minta mereka membuka Nuphos di sana dan memilih Masuk di halaman Runtime."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はチームメイトのものなので、サインインできるのはその人だけです。そのコンピュータで Nuphos を開き、ランタイムのページでサインインを選ぶよう依頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 팀원의 것이므로 그 팀원만 로그인할 수 있습니다. 해당 컴퓨터에서 Nuphos를 열고 런타임 페이지에서 로그인을 선택하도록 요청하세요."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ เป็นของเพื่อนร่วมทีม จึงมีเพียงเขาเท่านั้นที่ลงชื่อเข้าใช้ได้ ขอให้เขาเปิด Nuphos บนเครื่องนั้นแล้วเลือกลงชื่อเข้าใช้ในหน้ารันไทม์"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 属于你的队友，只有对方可以登录。请对方在那台电脑上打开 Nuphos，并在“运行环境”页面选择登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 屬於你的隊友，只有對方可以登入。請對方在那台電腦上開啟 Nuphos，並在「執行環境」頁面選擇登入。"
          }
        }
      }
    },
    "%@ is paused. It resumes when you send." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está en pausa. Se reanudará cuando envíes un mensaje."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sedang dijeda. Akan berjalan lagi saat Anda mengirim pesan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は一時停止中です。送信すると再開します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 일시 중지되었습니다. 보내면 다시 시작됩니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ หยุดชั่วคราวอยู่ จะทำงานต่อเมื่อคุณส่งข้อความ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已暂停，发送消息后会自动恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已暫停，傳送訊息後會自動恢復。"
          }
        }
      }
    },

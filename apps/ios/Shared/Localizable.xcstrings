    "This device signed in before device management existed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo inició sesión antes de que existiera la administración de dispositivos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat ini masuk sebelum fitur pengelolaan perangkat tersedia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスはデバイス管理機能の導入前にサインインしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기는 기기 관리 기능이 도입되기 전에 로그인했습니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อุปกรณ์นี้ลงชื่อเข้าใช้ก่อนที่จะมีระบบจัดการอุปกรณ์"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备在设备管理功能推出前登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置是在推出裝置管理功能之前登入的。"
          }
        }
      }
    },
    "This disconnects the runtime. Your tasks stay in Nuphos." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto desconecta el entorno de ejecución. Tus tareas se quedan en Nuphos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini memutuskan runtime. Tugas Anda tetap di Nuphos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ランタイムとの接続を解除します。タスクは Nuphos に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "런타임 연결을 해제합니다. 태스크는 Nuphos에 남습니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดำเนินการนี้จะตัดการเชื่อมต่อรันไทม์ งานของคุณยังอยู่ใน Nuphos"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会断开运行环境的连接。你的任务会保留在 Nuphos 中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會中斷執行環境的連接。你的任務會保留在 Nuphos 中。"
          }
        }
      }
    },
    "This image could not be read." : {

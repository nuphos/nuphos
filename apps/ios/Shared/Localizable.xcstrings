    "Already invited? Accept the invitation from your email, then refresh your workspaces." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ya te invitaron? Acepta la invitación desde tu correo y actualiza tus espacios de trabajo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sudah diundang? Terima undangan dari email Anda, lalu muat ulang workspace."

          "stringUnit" : {
            "state" : "translated",
            "value" : "값은 태스크 런타임의 파일에 기록되며 이 태스크에는 표시되지 않습니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค่านี้จะถูกเขียนลงไฟล์ในรันไทม์ของงาน และจะไม่ปรากฏในงานนี้"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个值会写入任务运行环境中的文件，不会出现在此任务中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個值會寫入任務執行環境中的檔案，不會出現在此任務中。"
          }
        }
      }
    },
    "The values are written to files on the task's runtime and entered on %@ without passing through this task." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores se escriben en archivos del entorno de ejecución de la tarea y se introducen en %@ sin pasar por esta tarea."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nilai-nilai ditulis ke file di runtime tugas dan dimasukkan di %@ tanpa melewati tugas ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "値はタスクの実行環境上のファイルに書き込まれ、このタスクを経由せずに %@ に入力されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "값은 태스크 런타임의 파일에 기록되며 이 태스크를 거치지 않고 %@에 입력됩니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค่าเหล่านี้จะถูกเขียนลงไฟล์ในรันไทม์ของงาน และกรอกใน %@ โดยไม่ผ่านงานนี้"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些值会写入任务运行环境中的文件，并填入 %@，填入过程不经过此任务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些值會寫入任務執行環境中的檔案，並填入 %@，填入過程不經過此任務。"
          }
        }
      }
    },

    "This is a Bot. Archive the Bot?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto es un bot. ¿Archivar el bot?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini adalah Bot. Arsipkan Bot?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは Bot です。Bot をアーカイブしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이것은 봇입니다. 봇을 보관할까요?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นี่คือบอท จะเก็บบอทนี้ถาวรไหม"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

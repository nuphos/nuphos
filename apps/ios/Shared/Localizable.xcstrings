    "The computer running this runtime is offline. Open Nuphos on it, or switch to another runtime." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La computadora que ejecuta este entorno está sin conexión. Abre Nuphos en ella o cambia a otro entorno de ejecución."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komputer yang menjalankan runtime ini sedang offline. Buka Nuphos di sana, atau beralih ke runtime lain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このランタイムを実行しているコンピュータはオフラインです。そのコンピュータで Nuphos を開くか、別のランタイムに切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 런타임을 실행하는 컴퓨터가 오프라인입니다. 해당 컴퓨터에서 Nuphos를 열거나 다른 런타임으로 전환하세요."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คอมพิวเตอร์ที่รันรันไทม์นี้ออฟไลน์อยู่ เปิด Nuphos บนเครื่องนั้น หรือสลับไปใช้รันไทม์อื่น"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行这个运行环境的电脑已离线。请在那台电脑上打开 Nuphos，或切换到其他运行环境。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {

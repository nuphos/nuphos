    "The computer could not start. Delete it on the Runtimes page and try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo iniciar la computadora. Elimínala en la página Entornos de ejecución y vuelve a intentarlo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komputer tidak dapat dimulai. Hapus di halaman Runtime lalu coba lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータを起動できませんでした。［ランタイム］ページで削除してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터를 시작할 수 없습니다. 런타임 페이지에서 삭제한 후 다시 시도하세요."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คอมพิวเตอร์เริ่มทำงานไม่ได้ ลบเครื่องนี้ที่หน้ารันไทม์ แล้วลองอีกครั้ง"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电脑无法启动。请在“运行环境”页面中将其删除后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電腦無法啟動。請在「執行環境」頁面中刪除後再試一次。"
          }
        }
      }
    },
    "The computer did not answer as a VNC server." : {

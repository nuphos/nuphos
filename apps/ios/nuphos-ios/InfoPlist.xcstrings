    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nuphos records your voice only while you dictate a message, then sends it to OpenAI to transcribe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuphos graba tu voz solo mientras dictas un mensaje y luego la envía a OpenAI para transcribirla."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuphos hanya merekam suara Anda saat Anda mendikte pesan, lalu mengirimkannya ke OpenAI untuk ditranskripsikan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuphos はメッセージを音声入力している間だけ声を録音し、文字起こしのために OpenAI に送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuphos는 메시지를 받아쓰는 동안에만 음성을 녹음하고, 텍스트 변환을 위해 OpenAI로 전송합니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuphos จะบันทึกเสียงของคุณเฉพาะตอนที่คุณพูดข้อความเท่านั้น แล้วส่งไปให้ OpenAI ถอดความ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuphos 只会在你口述消息时录下你的声音，并发送给 OpenAI 转写成文字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuphos 只會在你口述訊息時錄下你的聲音，並傳送給 OpenAI 轉寫成文字。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {

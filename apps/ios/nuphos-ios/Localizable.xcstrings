    "Get notified when a computer you own or use has been offline for 2 minutes, and when it's back." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe un aviso cuando una computadora tuya o que usas lleve 2 minutos sin conexión, y cuando vuelva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapatkan notifikasi saat komputer yang Anda miliki atau gunakan offline selama 2 menit, dan saat kembali online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有または使用しているコンピュータが 2 分間オフラインになったときと、オンラインに戻ったときに通知します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소유하거나 사용하는 컴퓨터가 2분 동안 오프라인일 때와 다시 온라인이 될 때 알림을 받습니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รับการแจ้งเตือนเมื่อคอมพิวเตอร์ที่คุณเป็นเจ้าของหรือใช้งานออฟไลน์นาน 2 นาที และเมื่อกลับมาออนไลน์"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你拥有或使用的电脑离线超过 2 分钟，以及重新上线时通知你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當你擁有或使用的電腦離線超過 2 分鐘，以及重新上線時通知你。"

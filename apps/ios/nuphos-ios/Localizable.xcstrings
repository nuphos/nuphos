    },
    "For your security, sign in again to continue." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por tu seguridad, vuelve a iniciar sesión para continuar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demi keamanan Anda, masuk lagi untuk melanjutkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セキュリティのため、続行するには再度サインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보안을 위해 계속하려면 다시 로그인하세요."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อความปลอดภัย โปรดลงชื่อเข้าใช้อีกครั้งเพื่อดำเนินการต่อ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了你的安全，请重新登录以继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了你的安全，請重新登入以繼續。"
          }
        }
      }
    },
    "For your security, this needs a sign-in from the last 10 minutes." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",

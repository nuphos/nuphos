    "That device will need to sign in again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese dispositivo tendrá que volver a iniciar sesión."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat itu harus masuk lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのデバイスで再度サインインが必要になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 기기에서 다시 로그인해야 합니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อุปกรณ์นั้นจะต้องลงชื่อเข้าใช้อีกครั้ง"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该设备需要重新登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該裝置需要重新登入。"
          }
        }
      }
    },
    "The agent is still building this plan — steps, cost and risk arrive before it can be approved." : {

    },
    "The agent is working. You can send this when its turn ends." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El agente está trabajando. Puedes enviarlo cuando termine su turno."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agen sedang bekerja. Anda dapat mengirim ini setelah gilirannya selesai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントが作業中です。ターンが終わったら送信できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 작업 중입니다. 차례가 끝나면 보낼 수 있습니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เอเจนต์กำลังทำงานอยู่ คุณส่งข้อมูลนี้ได้เมื่อรอบการทำงานจบ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代理正在工作。它的回合结束后即可发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代理正在工作。它的回合結束後即可傳送。"
          }
        }
      }
    },
    "The code expires in 10 minutes." : {

    },
    "The plan is kept for reference but will no longer be run." : {

    },
    "The prompt sets the writing style and spells names Whisper doesn't know, such as products and services. Voice input is included with a Nuphos subscription; recordings are transcribed by OpenAI Whisper." : {

    },
    "The task owner can choose credentials for this task." : {

    },
    "The value is written to a file on the task's runtime and never appears in this task." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El valor se escribe en un archivo del entorno de ejecución de la tarea y nunca aparece en esta tarea."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nilai ditulis ke file di runtime tugas dan tidak pernah muncul di tugas ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "値はタスクの実行環境上のファイルに書き込まれ、このタスクには表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "값은 태스크 런타임의 파일에 기록되며 이 태스크에는 표시되지 않습니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค่านี้จะถูกเขียนลงไฟล์ในรันไทม์ของงาน และจะไม่ปรากฏในงานนี้"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个值会写入任务运行环境中的文件，不会出现在此任务中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個值會寫入任務執行環境中的檔案，不會出現在此任務中。"
          }
        }
      }
    },
    "The values are written to files on the task's runtime and entered on %@ without passing through this task." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores se escriben en archivos del entorno de ejecución de la tarea y se introducen en %@ sin pasar por esta tarea."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nilai-nilai ditulis ke file di runtime tugas dan dimasukkan di %@ tanpa melewati tugas ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "値はタスクの実行環境上のファイルに書き込まれ、このタスクを経由せずに %@ に入力されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "값은 태스크 런타임의 파일에 기록되며 이 태스크를 거치지 않고 %@에 입력됩니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค่าเหล่านี้จะถูกเขียนลงไฟล์ในรันไทม์ของงาน และกรอกใน %@ โดยไม่ผ่านงานนี้"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些值会写入任务运行环境中的文件，并填入 %@，填入过程不经过此任务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些值會寫入任務執行環境中的檔案，並填入 %@，填入過程不經過此任務。"
          }
        }
      }
    },
    "This device" : {
      "localizations" : {

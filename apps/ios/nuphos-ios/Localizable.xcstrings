    "%@ request closed. Ask the agent to request it again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La solicitud de %@ se cerró. Pide al agente que la solicite de nuevo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan %@ ditutup. Minta agen untuk memintanya lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のリクエストは終了しました。もう一度リクエストするようエージェントに依頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 요청이 닫혔습니다. 에이전트에게 다시 요청하도록 하세요."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำขอ %@ ปิดแล้ว ให้เอเจนต์ขออีกครั้ง"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的请求已关闭。请让 Agent 重新请求。"

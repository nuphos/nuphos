    "Enter a code from your authenticator app to continue." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce un código de tu app de autenticación para continuar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan kode dari aplikasi autentikator untuk melanjutkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続行するには認証アプリのコードを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계속하려면 인증 앱의 코드를 입력하세요."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ป้อนรหัสจากแอปยืนยันตัวตนเพื่อดำเนินการต่อ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入验证器 App 中的验证码以继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請輸入驗證器 App 中的驗證碼以繼續。"
          }
        }
      }
    },
    "Enter the 6-digit code from your authenticator app." : {
      "localizations" : {
        "es" : {

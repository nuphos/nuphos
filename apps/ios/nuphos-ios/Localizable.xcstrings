    "This device signed in before device management existed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo inició sesión antes de que existiera la administración de dispositivos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat ini masuk sebelum fitur pengelolaan perangkat tersedia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスはデバイス管理機能の導入前にサインインしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기는 기기 관리 기능이 도입되기 전에 로그인했습니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อุปกรณ์นี้ลงชื่อเข้าใช้ก่อนที่จะมีระบบจัดการอุปกรณ์"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备在设备管理功能推出前登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置是在推出裝置管理功能之前登入的。"
          }
        }
      }
    },
    "This disconnects the runtime. Your tasks stay in Nuphos." : {

    },
    "This is a Bot. Archive the Bot?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto es un bot. ¿Archivar el bot?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini adalah Bot. Arsipkan Bot?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは Bot です。Bot をアーカイブしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이것은 봇입니다. 봇을 보관할까요?"
          }
        },
        "th" : {
          "stringUnit" : {

    "Nuphos" : {

    },
    "Nuphos encrypts it on its way to the runtime, which keeps it; Nuphos does not keep a copy." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuphos lo cifra en su camino hacia el entorno de ejecución, que lo conserva; Nuphos no guarda ninguna copia."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuphos mengenkripsinya dalam perjalanan ke runtime, yang kemudian menyimpannya; Nuphos tidak menyimpan salinannya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ランタイムへの送信時に Nuphos が暗号化し、ランタイムが保持します。Nuphos はコピーを保持しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuphos는 이 정보를 암호화하여 런타임에 전달하며, 런타임이 보관합니다. Nuphos는 사본을 보관하지 않습니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuphos เข้ารหัสข้อมูลระหว่างส่งไปยังรันไทม์ซึ่งเป็นผู้เก็บไว้ Nuphos ไม่เก็บสำเนา"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuphos 会在传输到运行环境的过程中对其加密，由运行环境保存；Nuphos 不会保留副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuphos 會在傳送至執行環境的過程中加密，並由執行環境保存；Nuphos 不會保留副本。"
          }
        }
      }
    },
    "Nuphos returned an unexpected response (%lld)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuphos devolvió una respuesta inesperada (%lld)."

    "Ask Nuphos anything…" : {

    },
    "Ask for a code from an authenticator app each time you sign in, so a stolen password or email is not enough." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide un código de una app de autenticación cada vez que inicias sesión, para que una contraseña o un correo robados no basten."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minta kode dari aplikasi autentikator setiap kali Anda masuk, sehingga kata sandi atau email yang dicuri tidak cukup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインのたびに認証アプリのコードを求めます。パスワードやメールが盗まれてもサインインされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인할 때마다 인증 앱의 코드를 요구해, 비밀번호나 이메일이 도용되어도 로그인할 수 없게 합니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขอรหัสจากแอปยืนยันตัวตนทุกครั้งที่ลงชื่อเข้าใช้ เพื่อให้รหัสผ่านหรืออีเมลที่ถูกขโมยไม่เพียงพอ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次登录时都要求输入验证器 App 的验证码，这样即使密码或邮箱被盗也无法登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次登入時都要求輸入驗證器 App 的驗證碼，這樣即使密碼或電子郵件遭竊也無法登入。"
          }
        }
      }
    },
    "Ask the agent to schedule recurring work in this conversation." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide al agente que programe tareas recurrentes en esta conversación."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minta agen menjadwalkan pekerjaan rutin dalam percakapan ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この会話で定期的な作業をエージェントに依頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 대화에서 에이전트에게 정기 작업을 예약해 달라고 요청하세요."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขอให้เอเจนต์กำหนดเวลางานประจำในการสนทนานี้"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在此对话中告诉代理要定期执行的工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在此對話中告訴代理人要定期執行的工作。"
          }
        }
      }
    },

    "Its chat is archived with it. Unarchive either one to bring both back." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su chat se archiva con él. Desarchiva cualquiera de los dos para recuperar ambos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chat-nya ikut diarsipkan. Batalkan arsip salah satunya untuk mengembalikan keduanya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャットも一緒にアーカイブされます。どちらかをアーカイブ解除すると両方が戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채팅도 함께 보관됩니다. 어느 쪽이든 보관을 해제하면 둘 다 돌아옵니다."
          }
        },
        "th" : {

    "Create a workspace for your agents and runtimes, or join one your organization has made available." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un espacio de trabajo para tus agentes y entornos de ejecución, o únete a uno que tu organización haya habilitado."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat workspace untuk agen dan runtime Anda, atau bergabung dengan yang disediakan organisasi Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントとランタイム用のワークスペースを作成するか、組織が用意したワークスペースに参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트와 런타임을 위한 워크스페이스를 만들거나 조직에서 제공하는 워크스페이스에 참여하세요."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สร้างเวิร์กสเปซสำหรับเอเจนต์และรันไทม์ของคุณ หรือเข้าร่วมเวิร์กสเปซที่องค์กรเปิดให้ใช้"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为你的 Agent 和运行环境创建工作区，或加入组织提供的工作区。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為你的 Agent 與執行環境建立工作區，或加入組織提供的工作區。"
          }
        }
      }
    },
    "Create or join a workspace to start chatting with an agent." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",

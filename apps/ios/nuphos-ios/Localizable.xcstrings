    "Sign-in will no longer ask for a code. Enter one to confirm." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión dejará de pedir un código. Introduce uno para confirmar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proses masuk tidak akan lagi meminta kode. Masukkan satu kode untuk mengonfirmasi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインイン時にコードを求めなくなります。確認のためコードを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 시 더 이상 코드를 묻지 않습니다. 확인하려면 코드를 입력하세요."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การลงชื่อเข้าใช้จะไม่ขอรหัสอีกต่อไป ป้อนรหัสเพื่อยืนยัน"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录时将不再要求验证码。请输入一个验证码以确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登入時將不再要求驗證碼。請輸入一組驗證碼以確認。"
          }
        }

        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置是在推出裝置管理功能之前登入的。"
          }
        }
      }
    },
    "This disconnects the runtime. Your tasks stay in Nuphos." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto desconecta el entorno de ejecución. Tus tareas se quedan en Nuphos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini memutuskan runtime. Tugas Anda tetap di Nuphos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ランタイムとの接続を解除します。タスクは Nuphos に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "런타임 연결을 해제합니다. 태스크는 Nuphos에 남습니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดำเนินการนี้จะตัดการเชื่อมต่อรันไทม์ งานของคุณยังอยู่ใน Nuphos"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会断开运行环境的连接。你的任务会保留在 Nuphos 中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會中斷執行環境的連接。你的任務會保留在 Nuphos 中。"
          }
        }
      }
    },
    "This image could not be read." : {
      "localizations" : {

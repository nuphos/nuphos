<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries><package android:name="${fixtureReceiver}" /></queries>
    <application android:label="Synthetic share sender" android:allowBackup="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".ShareSenderActivity" android:exported="true" android:launchMode="singleTask">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <provider android:name=".SyntheticShareProvider" android:authorities="${fixtureAuthority}" android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>

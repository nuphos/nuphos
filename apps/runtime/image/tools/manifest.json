    "build-essential": {
      "version": "14",
      "kind": "apt",
      "apt": ["gcc", "g++", "make", "libc6-dev"],
      "env": {
        "LD_LIBRARY_PATH": "{root}/usr/lib/{triplet}",
        "LIBRARY_PATH": "{root}/usr/lib/{triplet}"
      },
      "commands": {
        "gcc": {
          "path": "root/usr/bin/gcc",
          "args": ["-idirafter", "{root}/usr/include/{triplet}", "-idirafter", "{root}/usr/include"]
        },
        "cc": {
          "path": "root/usr/bin/gcc",
          "args": ["-idirafter", "{root}/usr/include/{triplet}", "-idirafter", "{root}/usr/include"]
        },
        "g++": {
          "path": "root/usr/bin/g++",
          "args": ["-idirafter", "{root}/usr/include/{triplet}", "-idirafter", "{root}/usr/include"]
        },
        "c++": {
          "path": "root/usr/bin/g++",
          "args": ["-idirafter", "{root}/usr/include/{triplet}", "-idirafter", "{root}/usr/include"]
        },
        "cpp": {
          "path": "root/usr/bin/cpp",
          "args": ["-idirafter", "{root}/usr/include/{triplet}", "-idirafter", "{root}/usr/include"]
        },
        "make": "root/usr/bin/make",
        "as": "root/usr/bin/as",
        "ld": "root/usr/bin/ld",
        "ar": "root/usr/bin/ar",
        "nm": "root/usr/bin/nm",
        "ranlib": "root/usr/bin/ranlib",
        "strip": "root/usr/bin/strip",
        "objdump": "root/usr/bin/objdump",
        "objcopy": "root/usr/bin/objcopy",
        "readelf": "root/usr/bin/readelf"
      }
    },

# Nuphos backend environment.
#
# This file is the catalog of every *configurable* backend environment variable.
# A unit test (src/config.env-sync.test.ts) enforces that this file and
# src/config.ts declare exactly the same keys, and that no source file reads
# process.env / Bun.env outside config.ts. When a PR adds, removes, or renames
# an env var it MUST update both config.ts and this file in the same change.
# Exception: a handful of runtime/platform-injected vars (HOSTNAME, TMPDIR,
# POD_NAMESPACE, NODE_NAME, GIT_SHA, ATLAS_BACKEND_VERSION,
# TERMINATION_GRACE_SECONDS) are read by config.ts but never set by hand, so they
# live in the test's allowlist, not here.
#
# Convention: keys that must usually be set are left uncommented (empty or with
# a sensible default); advanced/rarely-tuned knobs are shown commented-out with
# their built-in default. Both forms count as "documented".

# ── Core ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Set automatically by bun run dev; leave unset for a standalone backend.
# NUPHOS_DEV_LAUNCHER_PID=
MONGODB_URI=mongodb://user:password@host:port
MONGODB_DB=atlas

# ── Admin ────────────────────────────────────────────────────────────────────
# Admin access = membership in this team (Zeabur Inc.). Defaults to the prod
# team id; override for a self-hosted deployment.
# ATLAS_ADMIN_TEAM_ID=69e989027ab63e8d6a0ffcb6
# Extra cookie names (comma-separated) accepted as the admin session cookie.
ATLAS_ADMIN_COOKIE_NAMES=

# ── Auth ─────────────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Session JWT signing secret. NUPHOS_JWT_SECRET is preferred; JWT_SECRET_KEY is
# the legacy fallback. One of them must be set to issue sessions / MCP tokens.
NUPHOS_JWT_SECRET=
# JWT_SECRET_KEY=
NUPHOS_SESSION_TTL_SEC=2592000
# Public origin of this backend (used for OAuth/MCP metadata + OIDC issuer).
NUPHOS_AUTH_BASE_URL=http://localhost:3000
# NUPHOS_PUBLIC_URL fills in publicBaseUrl when NUPHOS_AUTH_BASE_URL is unset.
# NUPHOS_PUBLIC_URL=
# Browser-facing OAuth authorize origin (e.g. https://nuphos.ai, which proxies
# /oauth/authorize* to the API). Empty = same as the public base URL.
# NUPHOS_OAUTH_AUTHORIZE_BASE_URL=

# ── Email OTP (Zeabur Email / ZSend) ─────────────────────────────────────────
# Create a send_only key with `npx zeabur@latest email keys create`; the from
# address must use a domain verified in ZSend. Without both, /auth/email/* 503s.
ZSEND_API_KEY=
NUPHOS_EMAIL_FROM=Nuphos <noreply@nuphos.ai>
# Local stacks only (ignored when NODE_ENV=production): log sign-in codes as
# auth.email_otp.dev_code instead of emailing them.
# NUPHOS_DEV_EMAIL_OTP_LOG=false
# Local stacks only (ignored when NODE_ENV=production): accept ws:// runtimes on
# loopback or a compose service name, and treat them as internal.
# NUPHOS_LOCAL_STACK=false

# ── Website download handoff ────────────────────────────────────────────────
# Shared with the nuphos.ai server only. Authenticates calls to the backend's
# Redis-backed email-handoff limiter; without it the limiter fails closed.
DOWNLOAD_HANDOFF_RATE_LIMIT_SECRET=

# ── Provider billing (FinOps "billed" figures) ───────────────────────────────
# What the cloud provider actually invoices, read from the BigQuery billing
# export and synced into Mongo hourly. Leave the table unset to disable the
# whole feature — the FinOps page then shows derived costs only.
# Fully-qualified export table, e.g. my-project.billing_sync.billing_export.
# It usually lives in another GCP project, so the runtime service account needs
# roles/bigquery.dataViewer there.
PROVIDER_BILLING_BQ_TABLE=
# Project the BigQuery jobs are billed to (needs roles/bigquery.jobUser).
# Defaults to the table's own project.
PROVIDER_BILLING_BQ_PROJECT_ID=
# Which project.id in the export is ours; everything else belongs to other
# Zeabur projects and must not be counted.
PROVIDER_BILLING_GCP_PROJECT_ID=nuphos
# How far back each sync re-reads. Billing rows keep landing for a day or two
# after the usage hour, so too short a window freezes yesterday's total.
PROVIDER_BILLING_LOOKBACK_DAYS=5
PROVIDER_BILLING_SYNC_INTERVAL_MINUTES=60

# ── Dev TLS (local https) ────────────────────────────────────────────────────
# ATLAS_DEV_TLS_CERT=
# ATLAS_DEV_TLS_KEY=
# Local stacks only (ignored when NODE_ENV=production): also serve plain HTTP on
# this port, for local containers that cannot trust the dev certificate. 0 = off.
# NUPHOS_DEV_HTTP_PORT=0

# ── On-prem Kubernetes relay (apps/kube-relay) ───────────────────────────────
# Lets an agent reach a customer's private cluster through the outbound-only
# pod in apps/kube-relay-agent. Leave the first three unset and the feature
# stays dormant: no cluster can be enrolled and nothing else changes.
# The secret must be byte-identical to the relay's own NUPHOS_RELAY_TOKEN_SECRET
# and at least 32 bytes — the backend refuses to start below that, because the
# relay does too. Rotating it invalidates every enrolled cluster at once.
NUPHOS_RELAY_TOKEN_SECRET=
# host:port the customer's agent pod dials (no scheme, no path).
NUPHOS_RELAY_AGENT_ENDPOINT=
# host:port of the relay's CONNECT proxy, used as a kubeconfig proxy-url —
# client-go rejects a proxy URL with a path. Bare host:port means https; prefix
# http:// only for a local plaintext relay (see apps/kube-relay/README.md).
NUPHOS_RELAY_PROXY_ENDPOINT=
# Authenticated status endpoint, used only to report whether a customer's pod is
# currently connected. Production exposes it over the proxy's TLS listener so
# backend replicas in either cluster can reach the same relay.
# NUPHOS_RELAY_STATUS_URL=https://relay.nuphos.ai:8443
# The agent image handed to customers, pinned by @sha256: digest — never a
# mutable tag, or a manifest already applied in someone's cluster can quietly
# start running different code. No default: unset leaves the feature dormant.
NUPHOS_RELAY_AGENT_IMAGE=

# ── Graceful shutdown ────────────────────────────────────────────────────────
# Both optional; the defaults below are what production runs on. They are only
# requests: config.ts clamps them to fit the pod's terminationGracePeriodSeconds
# (lib/shutdown-budget.ts), which arrives as TERMINATION_GRACE_SECONDS from the
# Deployment and so lives in the guard test's INFRA_ALLOWLIST, not here.
# AGENT_SHUTDOWN_LB_GRACE_MS=5000
# AGENT_SHUTDOWN_DRAIN_DEADLINE_MS=150000

# ── PostHog error tracking (optional) ────────────────────────────────────────
# Captures sanitized backend + Agent Chat errors (no bodies, contents, commands,
# headers, or tokens). POSTHOG_PROJECT_API_KEY is an accepted alias.
POSTHOG_API_KEY=
# POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ── Slack ingress ────────────────────────────────────────────────────────────
# Event Subscriptions Request URL:  https://<backend-host>/slack/events
# Interactivity Request URL:        https://<backend-host>/slack/interactions
# "Install Slack App" OAuth redirect: https://<backend-host>/slack-app/setup
SLACK_SIGNING_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_SETUP_REDIRECT=
SLACK_TOKEN_ENCRYPTION_KEY=
# Legacy single-workspace bot (optional once OAuth installs are enabled):
SLACK_BOT_TOKEN=
SLACK_BOT_USER_ID=
# Bot user id posting as the agent, when different from SLACK_BOT_USER_ID.
# SLACK_AGENT_USER_ID=

# ── Discord ingress ──────────────────────────────────────────────────────────
# OAuth redirect: https://<backend-host>/discord-app/setup
# The bot consumes direct @mentions over the Gateway. Message Content is not
# required until plain, unmentioned replies in an existing thread are enabled.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT=
DISCORD_PUBLIC_KEY=

# ── Lark (Feishu) ────────────────────────────────────────────────────────────
# The Lark connector is CUSTOM-APP-ONLY: each Nuphos team registers its own
# Feishu 企业自建应用 in the desktop app (app_id / app_secret / Encrypt Key) and
# points that app's Event Request URL at https://<backend-host>/lark/events/<app_id>.
# There is no global Nuphos Lark app, so no app-level env vars — only the key that
# encrypts each team's stored credentials at rest. Falls back to
# LINEAR_TOKEN_ENCRYPTION_KEY when unset (one key can cover all connectors).
LARK_TOKEN_ENCRYPTION_KEY=
# Optional key-id label stamped into the envelope (for key rotation). Defaults to "default".
LARK_TOKEN_ENCRYPTION_KEY_ID=

# ── iOS push notifications (APNs; optional) ──────────────────────────────────
# Token-based auth with an APNs key (.p8) from the Apple Developer portal.
# Leave the key id, team id or private key empty and push is a silent no-op.
# APNS_PRIVATE_KEY is the .p8 file's PEM contents; literal \n is accepted.
# APNS_ENV (sandbox|production) is the fallback for devices that do not report
# their own environment.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=ai.nuphos.ios
APNS_PRIVATE_KEY=
APNS_ENV=production

# ── Redis (sentinel; optional) ───────────────────────────────────────────────
# Enables cross-replica pub/sub for run streams. Off ⇒ single-replica in-memory.
# ATLAS_REDIS_ENABLED=false
ATLAS_REDIS_SENTINELS=
# ATLAS_REDIS_MASTER=mymaster
REDIS_PASSWORD=
# Off-cluster escape hatch: "host:port=host:port,..." to remap Sentinel-returned
# in-cluster master DNS to a locally reachable host. Empty in normal runs.
# ATLAS_REDIS_NAT_MAP=

# ── BYOS: AWS ────────────────────────────────────────────────────────────────
# The OIDC private key is the RS256 signing key for the Nuphos web-identity
# issuer, shared by Tencent/Aliyun/Volcengine (one Nuphos IdP). AWS BYOS has no
# static-credential fallback.
AWS_BYOS_OIDC_PRIVATE_KEY=
# AWS_BYOS_OIDC_PRIVATE_KEY_BASE64=
# Comma-separated base64 PEM public keys served in the JWKS during rotation.
# AWS_BYOS_OIDC_ADDITIONAL_PUBLIC_KEYS_BASE64=
# Issuer URL customers register (public HTTPS origin, no port). Defaults to the
# auth public base URL.
# AWS_BYOS_OIDC_ISSUER=

# ── BYOS: GCP ────────────────────────────────────────────────────────────────
# Workload identity federation, the keyless path. The pool and provider live in
# Nuphos's OWN GCP project and trust the AWS_BYOS_OIDC issuer above, so customers
# create nothing: they grant Service Account Token Creator on their own service
# account to
#   principal://iam.googleapis.com/projects/<number>/locations/global/
#     workloadIdentityPools/<pool>/subject/nuphos:team:<teamId>
# and Google pins the grant to that team. Project NUMBER, not project id.
GCP_BYOS_WIF_PROJECT_NUMBER=
GCP_BYOS_WIF_POOL_ID=
GCP_BYOS_WIF_PROVIDER_ID=
# Tencent / Aliyun / Volcengine / Azure reuse the AWS connector's OIDC signing
# key/issuer/JWKS; their STS/Entra audiences are fixed cloud constants, so no env
# vars are needed.

# ── Database credentials ─────────────────────────────────────────────────────
# Dedicated AES-256-GCM key for direct database credentials. This intentionally
# has no fallback to connector/BYOS keys. Generate 32 random bytes and encode as
# base64 (or provide 64 hex characters). Keep the previous key available while
# rotating or re-bind connections sealed by the previous key id.
DATABASE_CREDENTIAL_ENCRYPTION_KEY=
DATABASE_CREDENTIAL_ENCRYPTION_KEY_ID=default

# Optional rootless tsnet companion for database connections whose hosts are
# reachable only inside a customer's tailnet. Both URLs are loopback-only;
# use the same high-entropy token for the backend and dialer process.
# DATABASE_TAILSCALE_DIALER_URL=http://127.0.0.1:4141
# DATABASE_TAILSCALE_DIALER_TOKEN=
# DATABASE_TAILSCALE_DIALER_TIMEOUT_MS=30000

# ── BYOS: GitHub App ─────────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_SETUP_REDIRECT=
GITHUB_APP_WEBHOOK_SECRET=

# ── BYOS: GitLab ─────────────────────────────────────────────────────────────
# OAuth app defaults for gitlab.com; self-hosted bindings supply their own
# client per binding. Tokens encrypted at rest with the encryption key.
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_SETUP_REDIRECT=
GITLAB_WEBHOOK_SECRET=
GITLAB_TOKEN_ENCRYPTION_KEY=
# SSRF guard escape hatch — allow binding private/loopback GitLab hosts.
# GITLAB_ALLOW_PRIVATE_HOSTS=false

# ── BYOS: Cloudflare ─────────────────────────────────────────────────────────
CLOUDFLARE_BYOK_ENCRYPTION_KEY=
# The only BYOK key-id still overridable via env: prod sealed existing Cloudflare
# credentials with a non-default id. Other providers hardcode 'default' (rotation
# isn't implemented yet); do the same here once prod data is re-sealed.
# CLOUDFLARE_BYOK_ENCRYPTION_KEY_ID=default
# Self-managed OAuth client (confidential; backend holds the secret).
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=
CLOUDFLARE_OAUTH_SETUP_REDIRECT=
# Authorize-time scopes (dot+hyphen strings). Overridable without a deploy.
# CLOUDFLARE_OAUTH_SCOPES=

# ── BYOS: BYOK encryption keys (shared fallback chain) ───────────────────────
# Each provider's key falls back to LINODE_ then CLOUDFLARE_BYOK_ENCRYPTION_KEY.
BETTERSTACK_BYOK_ENCRYPTION_KEY=
HETZNER_BYOK_ENCRYPTION_KEY=
LINODE_BYOK_ENCRYPTION_KEY=
NOTION_BYOK_ENCRYPTION_KEY=
# Encrypts PostHog connector OAuth tokens (pha_/phr_…); falls back to
# LINODE_ then CLOUDFLARE_ when unset. Unrelated to POSTHOG_API_KEY above.
POSTHOG_BYOK_ENCRYPTION_KEY=
# Encrypts the Resend API key (re_…) at rest. Falls back to the Linode /
# Cloudflare BYOK key when unset, so set it explicitly in any env you care about.
RESEND_BYOK_ENCRYPTION_KEY=
SECUREFRAME_BYOK_ENCRYPTION_KEY=
# Encrypts SonarQube user tokens; falls back to LINODE_ then CLOUDFLARE_ when unset.
SONARQUBE_BYOK_ENCRYPTION_KEY=
# Development only: exposes the isolated fixture scanner Agent tool.
SONARQUBE_FIXTURE_SCANNER_ENABLED=false
TAILSCALE_BYOK_ENCRYPTION_KEY=
UPSTASH_BYOK_ENCRYPTION_KEY=
UPTIME_KUMA_BYOK_ENCRYPTION_KEY=
ZEABUR_PROVIDER_ENCRYPTION_KEY=

# ── BYOS: Vanta ──────────────────────────────────────────────────────────────
# BYOK key encrypts pasted secrets; the OAuth block is the public-integration
# (authorization_code) scaffold — the client_credentials bind path needs none.
VANTA_BYOK_ENCRYPTION_KEY=
VANTA_OAUTH_CLIENT_ID=
VANTA_OAUTH_CLIENT_SECRET=
VANTA_OAUTH_SETUP_REDIRECT=
# VANTA_OAUTH_SCOPES=connectors.self:read-resource

# ── BYOS: Linear ─────────────────────────────────────────────────────────────
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_SETUP_REDIRECT=
LINEAR_WEBHOOK_SECRET=
LINEAR_TOKEN_ENCRYPTION_KEY=
# Optional key-id label stamped into the envelope (for key rotation). Defaults to "default".
LINEAR_TOKEN_ENCRYPTION_KEY_ID=

# ── BYOS: Jira (Atlassian) ───────────────────────────────────────────────────
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_SETUP_REDIRECT=
JIRA_TOKEN_ENCRYPTION_KEY=

# ── BYOS: Asana ──────────────────────────────────────────────────────────────
ASANA_OAUTH_CLIENT_ID=
ASANA_OAUTH_CLIENT_SECRET=
ASANA_OAUTH_SETUP_REDIRECT=
ASANA_TOKEN_ENCRYPTION_KEY=

# ── BYOS: Sentry ─────────────────────────────────────────────────────────────
SENTRY_OAUTH_CLIENT_ID=
SENTRY_OAUTH_CLIENT_SECRET=
SENTRY_OAUTH_SETUP_REDIRECT=
SENTRY_TOKEN_ENCRYPTION_KEY=
# SENTRY_TOKEN_ENCRYPTION_KEY_ID=default

# ── OpenTelemetry (optional; all off/defaulted unless OTEL_ENABLED=true) ──────
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=atlas-backend
# OTEL_SERVICE_VERSION=
# OTEL_DEPLOYMENT_ENVIRONMENT=
# Free-form resource attributes: "k1=v1,k2=v2".
# OTEL_RESOURCE_ATTRIBUTES=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# Per-signal endpoint/header overrides (default to <endpoint>/v1/<signal>):
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=
# OTEL_EXPORTER_OTLP_METRICS_HEADERS=
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=
# OTEL_TRACES_ENABLED=true
# OTEL_TRACES_SAMPLER_ARG=1
# OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=4096
# OTEL_DB_STATEMENT_LENGTH_LIMIT=2048
# OTEL_DB_CAPTURE_STATEMENT=false
# OTEL_METRICS_ENABLED=true
# OTEL_METRIC_EXPORT_INTERVAL=15000
# OTEL_METRIC_EXPORT_TIMEOUT=10000
# OTEL_RUNTIME_METRIC_INTERVAL_MS=10000
# OTEL_LOGS_ENABLED=true
# OTEL_LOG_LEVEL=info
# OTEL_LOG_CONSOLE=true
# OTEL_LOG_LEVEL_DIAG=error

# ── File transfer store (short-lived S3 objects; ZEA-9910) ───────────────────
# NUPHOS_FILE_TRANSFER_PROVIDER=s3
NUPHOS_FILE_TRANSFER_S3_BUCKET=
# NUPHOS_FILE_TRANSFER_S3_REGION=us-east-1
NUPHOS_FILE_TRANSFER_S3_ACCESS_KEY_ID=
NUPHOS_FILE_TRANSFER_S3_SECRET_ACCESS_KEY=
# Unset ⇒ real AWS S3. Set ⇒ any S3-compatible server (self-hosted RustFS or
# MinIO, Cloudflare R2, …); path-style addressing is applied automatically.
# NUPHOS_FILE_TRANSFER_S3_ENDPOINT=https://files.example.com

# ── Skills store (team/global skill overlays; ZEA-10066) ─────────────────────
# Builtin skills ship in the repo; editable scopes (global, teams/<teamId>) live
# in this bucket and sync into the cache dir. Unset bucket ⇒ routes disabled.
ATLAS_SKILLS_BUCKET=
# ATLAS_SKILLS_S3_REGION=us-east-1
ATLAS_SKILLS_S3_ACCESS_KEY_ID=
ATLAS_SKILLS_S3_SECRET_ACCESS_KEY=
# ATLAS_SKILLS_S3_ENDPOINT=https://files.example.com
# ATLAS_SKILLS_CACHE_DIR=/tmp/nuphos-skills-cache

# ── Audit journal (ZEA-10029) ────────────────────────────────────────────────
# HMAC key fingerprints redacted originals. Bucket unset ⇒ L1-only (no sealed
# WORM segments). Anchoring: TSA is free/public; the git anchor activates once
# the repo/token are provisioned.
JOURNAL_HMAC_KEY=
# JOURNAL_HMAC_KEY_ID=env-local
# JOURNAL_HMAC_KEY_VERSION=1
JOURNAL_S3_BUCKET=
# JOURNAL_S3_REGION=us-east-1
JOURNAL_AWS_ACCESS_KEY_ID=
JOURNAL_AWS_SECRET_ACCESS_KEY=
# JOURNAL_S3_ENDPOINT=https://files.example.com
JOURNAL_KMS_SIGNING_KEY_ID=
# JOURNAL_RETENTION_DAYS=400
# JOURNAL_TSA_URL=https://freetsa.org/tsr
JOURNAL_ANCHOR_GITHUB_REPO=
JOURNAL_ANCHOR_GITHUB_TOKEN=
# JOURNAL_ANCHOR_GITHUB_PATH=anchors.log

# ── Nuphos Agent — model ─────────────────────────────────────────────────────
# Which hosted-Claude backend serves every model call: 'bedrock' (default) or
# 'vertex' (GCP Vertex AI Model Garden). The two take DIFFERENT model id
# formats — Bedrock wants the inference profile
# (`us.anthropic.claude-opus-5` / `global.anthropic.claude-opus-5`), Vertex
# wants the bare id (`claude-opus-5`) — so AGENT_MODEL_ID must match whichever
# provider is selected.
AGENT_MODEL_PROVIDER=bedrock
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=
# Vertex only. Auth is Application Default Credentials — no key pair here; run
# `gcloud auth application-default login` locally, or bind a workload identity
# on the pod. 'global' is the Model Garden-recommended endpoint for Claude.
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global
AGENT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Model the turn loop switches to when a round exhausts retries on a retryable
# provider error (throttling / 5xx). Unset = keep retrying the primary model.
AGENT_FALLBACK_MODEL_ID=
# Sticky per-conversation fallback after a safety-filter refusal: once any turn
# finishes with finishReason 'content-filter', every later turn in that
# conversation runs on this model instead of the primary. Must match the
# selected provider's id format. Unset defaults to Opus 4.8 on Vertex; on
# Bedrock it reuses AGENT_MODEL_ID unless a Bedrock profile is set here.
AGENT_CONTENT_FILTER_FALLBACK_MODEL_ID=
# Model for conversation-history compaction (defaults to Haiku 4.5).
AGENT_COMPACTION_MODEL_ID=

# ── Nuphos Agent — memory delivery (ADR-0003) ────────────────────────────────
# automatic (default since 2026-07-22): search the full native pool from the
# latest user message, attach up to five compact matches at the message tail,
# then load detail on demand via memory_get(id).
# injection: the one-line memory indexes ride in context each turn (kept as an
# A/B arm; the Track A attribution layer records deliveryMode per turn).
# summary: only compact counts are injected; the model searches on demand via
# memory_get(query).
# MEMORY_DELIVERY_MODE=automatic
# ── Nuphos Agent — memory recall ladder (ADR-0008, built-ahead flags) ────────
# Rung 1.5: small-model rerank of keyword-search candidates. Enable when
# fetch-through degrades vs the G1 baseline; fails open to lexical order.
# MEMORY_RERANK_ENABLED=false
# Rung 3 ranking half: set to 'decay' to order the memory indexes by
# access-decay score (recency of update/fetch/verify × fetch frequency).
# Default 'recency' keeps raw updatedAt ordering.
# MEMORY_INDEX_RANKING=decay
# Track A attribution judge: post-hoc LLM verdict on whether recalled/fetched
# memories were actually applied in the answer. Off by default; fails open —
# attribution rows floor honestly at recalled/fetched when disabled or erroring.
# MEMORY_ATTRIBUTION_JUDGE=false
# Judge model id; unset falls back to the compaction model.
# MEMORY_ATTRIBUTION_JUDGE_MODEL=
# Fraction of turns the judge runs on when enabled (0–1, default 1 = every
# turn). One LLM call per sampled turn, so this is the judge's cost knob.
# Sampling is deterministic per turnKey; sampled-out turns record
# 'skipped_sampled', keeping coverage measurable and distinct from flag-off.
# MEMORY_ATTRIBUTION_JUDGE_SAMPLE_RATE=1
# Track A3 auto-ingest: post-turn distiller saves at most one durable memory
# per turn ('auto-learned' category, removable). Off by default; zero-yield is
# the expected common case — volatile observations are never learned.
# MEMORY_AUTO_INGEST=false
# Before writing an auto-learned memory, check whether it directly contradicts
# one already in the same pool and supersede that one instead of stacking a
# second opinion (a corrected belief should replace the wrong one, not sit
# beside it). Costs one small-model call per SAVED memory. Off by default: this
# is the only path that lets auto-ingest tombstone an existing record.
# MEMORY_CONFLICT_SUPERSEDE=false
# Memory backend id; must name a registered provider — boot fails otherwise;
# external-residency ids rejected as global default (override-only per A1).
# MEMORY_PROVIDER=native

# ── Nuphos Agent — Auto Mode ─────────────────────────────────────────────────
# Per-command authorization for the bash + local_exec tools. Always on:
# read-only commands auto-run, an LLM judge decides the rest against the user's
# standing policy, and the user can Bypass Permissions per-conversation.
# Judge model (defaults to AGENT_MODEL_ID). A stronger model (e.g. Opus 4.8)
# sharpens read/write effect classification.
AGENT_AUTO_MODE_JUDGE_MODEL_ID=
# AGENT_AUTO_MODE_JUDGE_TIMEOUT_MS=15000
# HMAC secret signing tool-approval requests. Falls back to JOURNAL_HMAC_KEY.
# AGENT_AUTO_MODE_APPROVAL_SECRET=

# ── Nuphos Agent — conversation auto-archive ─────────────────────────────────
# Conversations idle for this many days are archived by an hourly sweep on
# every replica (idempotent). Activity on an archived conversation, or a manual
# restore, brings it back. Set to 0 to disable.
# AGENT_AUTO_ARCHIVE_IDLE_DAYS=7

# ── Nuphos Agent — extended thinking (ZEA-10078) ─────────────────────────────
# AGENT_THINKING_MODE is the ONLY switch:
#   ''         disabled (default)
#   adaptive   thinking.type=adaptive + output_config.effort  (Opus 4.8+ models)
#   budget     thinking.type=enabled + budget_tokens          (Haiku 4.5 / older)
# The interface MUST match the ACTUAL deployed AGENT_MODEL_ID (the deployed value
# lives in the cluster Secret and differs from the default above — the 2026-07-07
# outage came from that mismatch). Before enabling ANYWHERE, run:
#   bun scripts/thinking-smoke.ts   (with the real model id + creds)
# AGENT_THINKING_EFFORT: low | medium | high | xhigh | max (adaptive mode only)
AGENT_THINKING_MODE=
AGENT_THINKING_EFFORT=medium
AGENT_THINKING_BUDGET_TOKENS=0
ATLAS_AGENT_MAX_OUTPUT_TOKENS=32000
ATLAS_AGENT_MODEL_OUTPUT_BUDGET_TOKENS=30000

# ── Nuphos Agent — Braintrust (tracing) ──────────────────────────────────────
# API key enables Braintrust tracing. Agent prompts live in-repo under
# apps/backend/src/lib/agent/prompts/ and need no configuration.
BRAINTRUST_API_KEY=
# BRAINTRUST_PROJECT_NAME=atlas-backend
# BRAINTRUST_TRACING_ENABLED=true

# ── Nuphos Agent — backend URL exposed inside sandboxes ──────────────────────
# Replace <namespace> with the backend's Kubernetes namespace for this env.
# ATLAS_BACKEND_URL is the legacy alias.
NUPHOS_BACKEND_URL=http://nuphos-backend.<namespace>.svc.cluster.local:3000
# ATLAS_BACKEND_URL=
# The same backend as a runtime outside the cluster sees it. Self-hosted
# runtimes fetch skills and call Nuphos tools here; registering one is refused
# while this is unset and NUPHOS_BACKEND_URL is cluster-internal.
NUPHOS_PUBLIC_BACKEND_URL=https://api.nuphos.ai

# ── Claude Code runtime (routing follows the team's workspace setting) ──────
# CLAUDE_CODE_RUNTIME_PROVISIONER_ENABLED=false # reconcile per-team OpenAB runtime pods
# NUPHOS_RUNTIME_VERSION=0.1.2 # nuphos-runtime release every managed agent runs (ghcr.io/zeabur/nuphos-runtime:<version>-claude-code / -codex); defaults to the version deploy/compose pins
# CLAUDE_CODE_RUNTIME_NAMESPACE=openab-runtimes # namespace the provisioner manages
# CLAUDE_CODE_RUNTIME_NODE_SELECTOR=cloud.google.com/gke-nodepool=pool-runtime # comma-separated key=value node labels runtime pods require; unset schedules them on any node
# CLAUDE_CODE_RUNTIME_NODE_TOLERATIONS=nuphos.ai/runtime=true # comma-separated key=value NoSchedule taints runtime pods tolerate; pair with the selector above so only runtimes reach the isolated pool
# CLAUDE_CODE_RUNTIME_CPU_LIMIT=4 # CPU limit for the agent container, in Kubernetes CPU units; `none` leaves it unbounded
# CLAUDE_CODE_RUNTIME_KUBECTL=false # dev only: use the operator's kubectl login instead of the in-cluster ServiceAccount
# CLAUDE_CODE_RUNTIME_KUBE_CONTEXT= # dev only: kubeconfig context for those kubectl calls (`bun run dev --managed` sets it)
# CLAUDE_CODE_RUNTIME_DEV_URL=ws://127.0.0.1:18080/acp # dev only: bypass the shared registry with a loopback OpenAB runtime
# CLAUDE_CODE_RUNTIME_DEV_AUTH_KEY= # dev only: transport key paired with CLAUDE_CODE_RUNTIME_DEV_URL
# CLAUDE_CODE_PREVIEW_TOKEN_ENCRYPTION_KEY= # base64 32-byte key; encrypts self-hosted runtime keys, derives managed runtimes' operator keys, and decrypts Claude Code tokens bound before agents signed in on their own
#   With NUPHOS_LOCAL_STACK=true (never in production) and no key set, one is derived from NUPHOS_JWT_SECRET.

# ── Nuphos Agent — retrieval / web tools (all optional) ──────────────────────
# RAG knowledge base; without it RAG tools are disabled.
RAG_API_KEY=
# Tavily web_search (free tier 1000 req/mo at https://tavily.com).
TAVILY_API_KEY=
# Firecrawl web_fetch (https://firecrawl.dev — JS-rendered sites → markdown).
FIRECRAWL_API_KEY=

# ---- Dashboards (script-driven live panels) ----
# Each dashboard panel is a stored JS script that runs on one of the team's agent
# runtimes and emits a validated snapshot. All optional; shown here with their defaults.
# Hard wall-clock cap for one panel script run (ms). Defaults to five minutes.
# DASHBOARD_PANEL_EXEC_TIMEOUT_MS=300000
# Max stdout bytes accepted from a panel run before parsing (DoS guard).
# DASHBOARD_PANEL_MAX_OUTPUT_BYTES=524288
# Optional max-age cap (ms) on reusing an immutable snapshot with the same script+params; 0 (default) = reuse indefinitely.
# DASHBOARD_PANEL_SNAPSHOT_FRESH_MS=0
# Snapshot TTL (days); each snapshot ages out on its own (per-document TTL).
# DASHBOARD_PANEL_SNAPSHOT_TTL_DAYS=400
# Model for the separate Insight pass; empty falls back to the agent model.
# DASHBOARD_PANEL_INSIGHT_MODEL=
# Deprecated aliases, read only when the DASHBOARD_PANEL_* name above is unset.
# Rename them in your deployment; they will be removed in a later release.
# COST_PANEL_EXEC_TIMEOUT_MS=
# COST_PANEL_MAX_OUTPUT_BYTES=
# COST_PANEL_SNAPSHOT_FRESH_MS=
# COST_PANEL_SNAPSHOT_TTL_DAYS=
# COST_PANEL_INSIGHT_MODEL=

# Codex runs alongside Claude Code under the same OpenAB provisioner/namespace.
# CODEX_RUNTIME_DEV_URL=ws://127.0.0.1:18081/acp # dev only; never used by Claude conversations
# CODEX_RUNTIME_DEV_AUTH_KEY= # paired with CODEX_RUNTIME_DEV_URL
# OPENAB_RUNTIME_TOKEN_ENCRYPTION_KEY= # optional alias for CLAUDE_CODE_PREVIEW_TOKEN_ENCRYPTION_KEY; use the SAME existing key

# Independent operator keys for local runtime control connections.
# Match OPENAB_ACP_CONTROL_KEY on each provider runtime; keep chat auth separate.
NUPHOS_CLAUDE_CONTROL_KEY=
NUPHOS_CODEX_CONTROL_KEY=
